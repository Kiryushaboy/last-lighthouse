; Файл настроек проекта Godot. Обычно его меняют через
; меню Project > Project Settings, а не руками.

config_version=5

[application]

config/name="Последний маяк"
config/description="Арена на выживание: продержитесь 5 минут до рассвета."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Settings="*res://scripts/settings.gd"
SaveData="*res://scripts/save_data.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemies"
2d_physics/layer_3="bullets"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)
textures/vram_compression/import_etc2_astc=true
